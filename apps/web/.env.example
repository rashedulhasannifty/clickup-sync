# ── Admin (DEV ONLY) ──────────────────────────────────────────────────────────
# Optional dev convenience: auto-fills the admin key so you skip the login
# screen. Must match ADMIN_API_KEY in the backend .env.
# ⚠️ Vite inlines this into the public JS bundle — NEVER set it for a production
# build. In production, enter the key in the login UI (stored in localStorage).
VITE_ADMIN_API_KEY=

# Note: the dashboard calls the API at the relative path "/api" (same origin),
# so no API base URL is needed. The webhook endpoint is configured in the app
# (Settings → Connection), not via env.

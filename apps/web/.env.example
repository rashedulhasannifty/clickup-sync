# ── Admin ─────────────────────────────────────────────────────────────────────
# Must match ADMIN_API_KEY in the backend .env
# Can also be set at runtime via the Settings page in the UI
VITE_ADMIN_API_KEY=

# ── ClickUp webhook ───────────────────────────────────────────────────────────
# Displayed as the suggested endpoint URL in the Settings page
# Defaults to https://your-domain.com/webhooks/clickup if not set
VITE_WEBHOOK_URL=https://your-domain.com/api/webhooks/clickup

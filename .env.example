# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL (docker-compose default)
DATABASE_URL=postgresql://clickup:clickup@localhost:5433/clickup_sync?schema=public

# Neon (cloud) — uncomment and fill in for staging/production
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ClickUp ───────────────────────────────────────────────────────────────────
# Use a Workspace Owner/Admin service account token (required for time-entry writes on behalf of assignees)
CLICKUP_API_TOKEN=pk_your_clickup_api_token_here
CLICKUP_TEAM_ID=3450636

# Public HTTPS URL this service is reachable at — used when registering the webhook with ClickUp
CLICKUP_WEBHOOK_ENDPOINT=https://your-domain.com/api/webhooks/clickup

# Secret returned by ClickUp when the webhook is created — used to verify incoming payloads
CLICKUP_WEBHOOK_SECRET=

# Comma-separated list of ClickUp event types to subscribe to
CLICKUP_WEBHOOK_EVENTS=taskCreated,taskUpdated,taskDeleted,taskTimeTrackedUpdated

# ClickUp user ID of the shared agency account whose time entries are split/replaced
CLICKUP_AGENCY_USER_ID=3584055

# ── Admin ─────────────────────────────────────────────────────────────────────
# Set a strong random string before deploying (e.g. openssl rand -hex 32)
ADMIN_API_KEY=

# ── Worker / Queue tuning ─────────────────────────────────────────────────────
JOB_ATTEMPTS=5
JOB_BACKOFF_DELAY_MS=30000
RECONCILE_EVERY_MINUTES=15
RECONCILE_LOOKBACK_HOURS=2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ClickupTask {
  taskId              String    @id @map("task_id")
  parentTaskId        String?   @map("parent_task_id")
  taskName            String    @map("task_name")
  description         String?
  markdownDescription String?   @map("markdown_description")
  url                 String?
  status              String?
  statusType          String?   @map("status_type")
  statusColor         String?   @map("status_color")
  priority            String?
  orderIndex          BigInt?   @map("order_index")
  archived            Boolean   @default(false)
  isDeleted           Boolean   @default(false) @map("is_deleted")
  createdDate         DateTime? @map("created_date")
  updatedDate         DateTime? @map("updated_date")
  closedDate          DateTime? @map("closed_date")
  dueDate             DateTime? @map("due_date")
  startDate           DateTime? @map("start_date")
  deletedAt           DateTime? @map("deleted_at")
  syncedAt            DateTime  @default(now()) @updatedAt @map("synced_at")
  syncCount           Int       @default(0) @map("sync_count")
  timeEstimate        BigInt?   @map("time_estimate")
  timeSpent           BigInt?   @map("time_spent")
  spaceId             String?   @map("space_id")
  spaceName           String?   @map("space_name")
  folderId            String?   @map("folder_id")
  folderName          String?   @map("folder_name")
  listId              String?   @map("list_id")
  listName            String?   @map("list_name")
  assigneesNames      String?   @map("assignees_names")
  assigneesEmails     String?   @map("assignees_emails")
  watchersNames       String?   @map("watchers_names")
  watchersEmails      String?   @map("watchers_emails")
  creatorId           String?   @map("creator_id")
  creatorName         String?   @map("creator_name")
  executiveName       String?   @map("executive_name")
  department          String?
  client              String?
  // ClickUp "Client" dropdown option id — stable across renames (`client` is the name).
  clientOptionId      String?   @map("client_option_id")
  // DERIVED access key, written by sync: own clientOptionId, else the parent's.
  // The ONLY column team scoping reads. Not a local annotation — sync owns it.
  scopeClientOptionId String?   @map("scope_client_option_id")
  // ClickUp "Sub-Project" labels field — a task can carry several. Mirrored
  // from ClickUp on every sync (an empty list clears it).
  subProjects         String[]  @default([]) @map("sub_projects")
  cost                Decimal   @default(0) @db.Decimal(14, 2)
  estimation          Decimal   @default(0) @db.Decimal(14, 2)
  sprintName          String?   @map("sprint_name")
  sprintPoints        Int       @default(0) @map("sprint_points")
  tags                String?
  customTags          String?   @map("custom_tags")
  raw                 Json?

  // ── Local annotations ───────────────────────────────────────────────────
  // Owned by THIS app, not mirrored from ClickUp. No sync path may write
  // these: `TasksRepository.upsert` spreads `NormalizedTask`, which contains
  // none of them, and a test enforces that. Anything added here inherits the
  // same rule — a sync that writes these silently reverts what a user set.
  isChargeable Boolean @default(true) @map("is_chargeable")

  timeEntries        ClickupTimeEntry[]
  chargeabilityRules TaskAssigneeChargeability[]

  @@index([parentTaskId])
  @@index([spaceId])
  @@index([updatedDate])
  @@index([subProjects], type: Gin)
  @@index([scopeClientOptionId])
  @@map("clickup_tasks")
}

model ClickupTimeEntry {
  timeEntryId     String    @id @map("time_entry_id")
  taskId          String?   @map("task_id")
  userId          String?   @map("user_id")
  userName        String?   @map("user_name")
  userEmail       String?   @map("user_email")
  startTime       DateTime? @map("start_time") @db.Timestamptz(6)
  endTime         DateTime? @map("end_time") @db.Timestamptz(6)
  durationHours   Decimal   @default(0) @map("duration_hours") @db.Decimal(12, 4)
  billable        Boolean   @default(false)
  description     String?
  rateId          BigInt?   @map("rate_id")
  currency        String    @default("AUD")
  hourlyRateCents BigInt    @default(0) @map("hourly_rate_cents")
  costCents       BigInt    @default(0) @map("cost_cents")
  status          String    @default("SYNCED")
  raw             Json?
  syncedAt        DateTime  @default(now()) @updatedAt @map("synced_at")

  // ── Local annotations ───────────────────────────────────────────────────
  // `chargeableOverride` is owned by THIS app, not mirrored from ClickUp. No
  // sync path may write it: `TimeEntriesRepository.upsert` spreads
  // `NormalizedTimeEntry` plus the cost object, and neither contains it. A
  // test enforces that. `isChargeable` is different — it is DERIVED, written
  // on every cost write as part of the cost object.
  chargeableOverride Boolean? @map("chargeable_override")
  isChargeable       Boolean  @default(true) @map("is_chargeable")

  task ClickupTask?  @relation(fields: [taskId], references: [taskId], onDelete: SetNull)
  rate AssigneeRate? @relation(fields: [rateId], references: [rateId], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([startTime])
  @@map("clickup_time_entries")
}

/// Local annotation: "this assignee's time on this task is (not) chargeable".
/// Sits between the task-level flag and the per-entry override.
model TaskAssigneeChargeability {
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  chargeable Boolean
  note       String?
  setBy      String?  @map("set_by")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  task ClickupTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignee_chargeability")
}

model AssigneeRate {
  rateId          BigInt    @id @default(autoincrement()) @map("rate_id")
  assigneeId      String    @map("assignee_id")
  assigneeName    String?   @map("assignee_name")
  assigneeEmail   String?   @map("assignee_email")
  currency        String    @default("AUD")
  hourlyRateCents BigInt    @map("hourly_rate_cents")
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  timeEntries ClickupTimeEntry[]

  @@unique([assigneeId, validFrom])
  @@index([assigneeId, validFrom, validTo])
  @@map("assignee_rates")
}

model ClientBudget {
  budgetId           BigInt    @id @default(autoincrement()) @map("budget_id")
  client             String
  monthlyAmountCents BigInt    @map("monthly_amount_cents")
  currency           String    @default("USD")
  validFrom          DateTime  @map("valid_from") @db.Date
  validTo            DateTime? @map("valid_to") @db.Date
  notes              String?
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([client, validFrom])
  @@index([client, validFrom, validTo])
  @@map("client_budgets")
}

model ClickupWebhookEvent {
  id           BigInt    @id @default(autoincrement())
  fingerprint  String    @unique
  eventType    String?   @map("event_type")
  taskId       String?   @map("task_id")
  rawPayload   Json      @map("raw_payload")
  status       String    @default("received")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")
  errorMessage String?   @map("error_message")

  @@index([eventType])
  @@index([taskId])
  @@index([receivedAt])
  @@map("clickup_webhook_events")
}

model ClickupWebhookSeen {
  fingerprint String   @id
  seenAt      DateTime @default(now()) @map("seen_at")

  @@map("clickup_webhook_seen")
}

// Single-row table (id = "singleton") holding UI-managed ClickUp connection
// settings. Secret columns hold AES-256-GCM ciphertext (see CryptoService).
model AppSettings {
  id                 String   @id @default("singleton")
  clickupApiTokenEnc String?  @map("clickup_api_token_enc")
  webhookSecretEnc   String?  @map("webhook_secret_enc")
  clickupTeamId      String?  @map("clickup_team_id")
  webhookEndpoint    String?  @map("webhook_endpoint")
  webhookEvents      String?  @map("webhook_events")
  spikeHoursCap      Int      @default(12) @map("spike_hours_cap")
  preferences        Json?    @map("preferences")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy          String?  @map("updated_by")

  @@map("app_settings")
}

model SyncCheckpoint {
  id                   BigInt    @id @default(autoincrement())
  source               String
  scopeType            String    @map("scope_type")
  scopeId              String    @map("scope_id")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at")
  lastAttemptedSyncAt  DateTime? @map("last_attempted_sync_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([source, scopeType, scopeId])
  @@map("sync_checkpoints")
}

model SyncJobLog {
  id                BigInt    @id @default(autoincrement())
  jobId             String?   @map("job_id")
  queueName         String    @map("queue_name")
  jobName           String    @map("job_name")
  status            String
  entityType        String?   @map("entity_type")
  entityId          String?   @map("entity_id")
  attemptsMade      Int       @default(0) @map("attempts_made")
  errorMessage      String?   @map("error_message")
  errorStack        String?   @map("error_stack")
  payload           Json?
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  tasksSynced       Int?      @map("tasks_synced")
  timeEntriesSynced Int?      @map("time_entries_synced")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([queueName, jobName])
  @@index([status])
  @@index([entityType, entityId])
  @@map("sync_job_logs")
}

model DeadLetterJob {
  id           BigInt    @id @default(autoincrement())
  queueName    String    @map("queue_name")
  jobName      String    @map("job_name")
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  payload      Json
  errorMessage String?   @map("error_message")
  errorStack   String?   @map("error_stack")
  attemptsMade Int?      @map("attempts_made")
  failedAt     DateTime  @default(now()) @map("failed_at")
  retriedAt    DateTime? @map("retried_at")
  resolvedAt   DateTime? @map("resolved_at")

  @@index([queueName, jobName])
  @@index([entityType, entityId])
  @@map("dead_letter_jobs")
}

model TagAssigneeMap {
  id              BigInt   @id @default(autoincrement())
  tagName         String   @unique @map("tag_name")
  clickupUserId   String   @map("clickup_user_id")
  clickupUserName String?  @map("clickup_user_name")
  clickupEmail    String?  @map("clickup_email")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("tag_assignee_map")
}

model TimeEntryReplacement {
  id                 BigInt   @id @default(autoincrement())
  originalEntryId    String   @unique @map("original_entry_id")
  replacementEntryId String?  @map("replacement_entry_id")
  taskId             String?  @map("task_id")
  originalUserId     String?  @map("original_user_id")
  replacedUserId     String?  @map("replaced_user_id")
  tagName            String?  @map("tag_name")
  status             String   @default("replaced")
  errorMessage       String?  @map("error_message")
  replacedAt         DateTime @default(now()) @map("replaced_at")

  @@index([taskId])
  @@index([originalUserId])
  @@map("time_entry_replacements")
}

model SpikeNotification {
  id             BigInt   @id @default(autoincrement())
  clickupUserId  String   @map("clickup_user_id")
  spikeDate      DateTime @map("spike_date") @db.Date
  recipientEmail String   @map("recipient_email")
  userName       String?  @map("user_name")
  totalHours     Decimal  @default(0) @map("total_hours") @db.Decimal(12, 4)
  rule           String?
  note           String?
  sentBy         String?  @map("sent_by")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@unique([clickupUserId, spikeDate])
  @@map("spike_notifications")
}

model SpikeResolution {
  id            BigInt   @id @default(autoincrement())
  clickupUserId String   @map("clickup_user_id")
  spikeDate     DateTime @map("spike_date") @db.Date
  userName      String?  @map("user_name")
  note          String?
  resolvedBy    String?  @map("resolved_by")
  resolvedAt    DateTime @default(now()) @map("resolved_at")

  @@unique([clickupUserId, spikeDate])
  @@map("spike_resolutions")
}

model AdminAuditLog {
  id           BigInt   @id @default(autoincrement())
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actor        String?
  method       String
  path         String
  routePattern String?  @map("route_pattern")
  statusCode   Int      @map("status_code")
  durationMs   Int?     @map("duration_ms")
  ip           String?
  userAgent    String?  @map("user_agent")
  requestBody  Json?    @map("request_body")
  errorMessage String?  @map("error_message")

  @@index([occurredAt])
  @@index([actor, occurredAt])
  @@index([routePattern, occurredAt])
  @@map("admin_audit_log")
}

model ClickupTaskEvent {
  id                BigInt   @id @default(autoincrement())
  taskId            String   @map("task_id")
  eventType         String   @map("event_type")
  occurredAt        DateTime @map("occurred_at")
  changedByUserId   String?  @map("changed_by_user_id")
  changedByUserName String?  @map("changed_by_user_name")
  before            Json?
  after             Json?
  fingerprint       String   @unique
  raw               Json?

  @@index([taskId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("clickup_task_events")
}

// ---------------------------------------------------------------------------
// Auth: Organizations, Users, Invitations, Sessions
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users           User[]
  invitations     Invitation[]
  teams           Team[]
  employees       Employee[]
  workShifts      WorkShift[]
  holidays        Holiday[]
  appraisalCycles AppraisalCycle[]

  @@map("organizations")
}

model User {
  id            String     @id @default(cuid())
  orgId         String     @map("org_id")
  email         String     @unique
  passwordHash  String     @map("password_hash")
  name          String?
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  clickupUserId String?    @unique @map("clickup_user_id")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  org             Organization    @relation(fields: [orgId], references: [id])
  sessions        Session[]
  passwordResets  PasswordReset[]
  teamMemberships TeamMember[]
  employee        Employee?

  @@index([orgId])
  @@map("users")
}

model Invitation {
  id              String           @id @default(cuid())
  orgId           String           @map("org_id")
  email           String
  role            Role
  tokenHash       String           @unique @map("token_hash")
  invitedByUserId String?          @map("invited_by_user_id")
  status          InvitationStatus @default(PENDING)
  clickupUserId   String?          @map("clickup_user_id")
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  org   Organization     @relation(fields: [orgId], references: [id])
  teams InvitationTeam[]

  @@index([email])
  @@index([orgId, status])
  @@map("invitations")
}

model PasswordReset {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ClickupList {
  listId     String    @id @map("list_id")
  name       String
  folderId   String?   @map("folder_id")
  folderName String?   @map("folder_name")
  spaceId    String?   @map("space_id")
  spaceName  String?   @map("space_name")
  archived   Boolean   @default(false)
  startDate  DateTime? @map("start_date")
  dueDate    DateTime? @map("due_date")
  syncedAt   DateTime  @default(now()) @map("synced_at")

  @@index([folderId])
  @@index([spaceId])
  @@index([archived])
  @@map("clickup_lists")
}

// ─── Xero (read-only finance sync) ─────────────────────────────────────────
// See docs/superpowers/specs/2026-09-15-xero-finance-design.md. Primary keys are
// Xero GUIDs (natural upsert keys, like clickup_tasks.task_id). Money is in the
// DOCUMENT currency; *_base columns are base-currency (amount / currency_rate).

enum XeroConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
  DISCONNECTED
}

model XeroConnection {
  id                String               @id @default("singleton")
  tenantId          String?              @map("tenant_id")
  connectionId      String?              @map("connection_id")
  tenantName        String?              @map("tenant_name")
  shortCode         String?              @map("short_code")
  baseCurrency      String?              @map("base_currency")
  accessTokenEnc    String?              @map("access_token_enc")
  refreshTokenEnc   String?              @map("refresh_token_enc")
  accessExpiresAt   DateTime?            @map("access_expires_at")
  refreshedAt       DateTime?            @map("refreshed_at")
  connectedByUserId String?              @map("connected_by_user_id")
  connectedByEmail  String?              @map("connected_by_email")
  connectedAt       DateTime?            @map("connected_at")
  status            XeroConnectionStatus @default(DISCONNECTED)
  lastError         String?              @map("last_error")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at")

  @@map("xero_connections")
}

model XeroContact {
  contactId       String   @id @map("contact_id") @db.Uuid
  name            String
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  email           String?
  phones          Json?
  addresses       Json?
  taxNumber       String?  @map("tax_number")
  defaultCurrency String?  @map("default_currency")
  isCustomer      Boolean  @default(false) @map("is_customer")
  isSupplier      Boolean  @default(false) @map("is_supplier")
  status          String
  updatedDateUtc  DateTime @map("updated_date_utc")
  raw             Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([name])
  @@map("xero_contacts")
}

model XeroInvoice {
  invoiceId      String    @id @map("invoice_id") @db.Uuid
  type           String
  number         String?
  reference      String?
  contactId      String?   @map("contact_id") @db.Uuid
  contactName    String?   @map("contact_name")
  status         String
  date           DateTime? @db.Date
  dueDate        DateTime? @map("due_date") @db.Date
  currencyCode   String    @map("currency_code")
  currencyRate   Decimal   @default(1) @map("currency_rate") @db.Decimal(18, 6)
  subTotal       Decimal   @default(0) @map("sub_total") @db.Decimal(14, 2)
  totalTax       Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  amountDue      Decimal   @default(0) @map("amount_due") @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountCredited Decimal   @default(0) @map("amount_credited") @db.Decimal(14, 2)
  totalBase      Decimal   @default(0) @map("total_base") @db.Decimal(14, 2)
  amountDueBase  Decimal   @default(0) @map("amount_due_base") @db.Decimal(14, 2)
  lineItems      Json      @map("line_items")
  hasAttachments Boolean   @default(false) @map("has_attachments")
  updatedDateUtc DateTime  @map("updated_date_utc")
  raw            Json
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([type, status])
  @@index([dueDate])
  @@index([date])
  @@index([updatedDateUtc])
  @@map("xero_invoices")
}

model XeroCreditNote {
  creditNoteId    String    @id @map("credit_note_id") @db.Uuid
  type            String
  number          String?
  reference       String?
  contactId       String?   @map("contact_id") @db.Uuid
  contactName     String?   @map("contact_name")
  status          String
  date            DateTime? @db.Date
  currencyCode    String    @map("currency_code")
  currencyRate    Decimal   @default(1) @map("currency_rate") @db.Decimal(18, 6)
  subTotal        Decimal   @default(0) @map("sub_total") @db.Decimal(14, 2)
  totalTax        Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  remainingCredit Decimal   @default(0) @map("remaining_credit") @db.Decimal(14, 2)
  totalBase       Decimal   @default(0) @map("total_base") @db.Decimal(14, 2)
  lineItems       Json      @map("line_items")
  hasAttachments  Boolean   @default(false) @map("has_attachments")
  updatedDateUtc  DateTime  @map("updated_date_utc")
  raw             Json
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([type, status])
  @@index([date])
  @@index([updatedDateUtc])
  @@map("xero_credit_notes")
}

model XeroBankTransaction {
  bankTransactionId String    @id @map("bank_transaction_id") @db.Uuid
  type              String
  contactId         String?   @map("contact_id") @db.Uuid
  contactName       String?   @map("contact_name")
  bankAccountCode   String?   @map("bank_account_code")
  bankAccountName   String?   @map("bank_account_name")
  reference         String?
  status            String
  isReconciled      Boolean   @default(false) @map("is_reconciled")
  date              DateTime? @db.Date
  currencyCode      String    @map("currency_code")
  currencyRate      Decimal   @default(1) @map("currency_rate") @db.Decimal(18, 6)
  subTotal          Decimal   @default(0) @map("sub_total") @db.Decimal(14, 2)
  totalTax          Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  total             Decimal   @default(0) @db.Decimal(14, 2)
  totalBase         Decimal   @default(0) @map("total_base") @db.Decimal(14, 2)
  lineItems         Json      @map("line_items")
  hasAttachments    Boolean   @default(false) @map("has_attachments")
  updatedDateUtc    DateTime  @map("updated_date_utc")
  raw               Json
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([type, status])
  @@index([date])
  @@index([updatedDateUtc])
  @@map("xero_bank_transactions")
}

model XeroPayment {
  paymentId        String    @id @map("payment_id") @db.Uuid
  paymentType      String    @map("payment_type")
  // 'in' | 'out' | null — null = not a cash movement we count (see cashDirection()).
  cashDirection    String?   @map("cash_direction")
  status           String
  invoiceId        String?   @map("invoice_id") @db.Uuid
  invoiceNumber    String?   @map("invoice_number")
  creditNoteId     String?   @map("credit_note_id") @db.Uuid
  creditNoteNumber String?   @map("credit_note_number")
  contactId        String?   @map("contact_id") @db.Uuid
  contactName      String?   @map("contact_name")
  date             DateTime? @db.Date
  currencyCode     String?   @map("currency_code")
  amount           Decimal   @default(0) @db.Decimal(14, 2)
  currencyRate     Decimal   @default(1) @map("currency_rate") @db.Decimal(18, 6)
  amountBase       Decimal   @default(0) @map("amount_base") @db.Decimal(14, 2)
  bankAccountCode  String?   @map("bank_account_code")
  bankAccountName  String?   @map("bank_account_name")
  reference        String?
  updatedDateUtc   DateTime  @map("updated_date_utc")
  raw              Json
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([creditNoteId])
  @@index([contactId])
  @@index([date])
  @@map("xero_payments")
}

model XeroAttachment {
  id            BigInt   @id @default(autoincrement())
  attachmentId  String   @map("attachment_id") @db.Uuid
  parentType    String   @map("parent_type")
  parentId      String   @map("parent_id") @db.Uuid
  fileName      String   @map("file_name")
  mimeType      String?  @map("mime_type")
  contentLength Int?     @map("content_length")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([parentId, attachmentId])
  @@index([parentId])
  @@map("xero_attachments")
}

model XeroSyncState {
  entity          String    @id
  watermark       DateTime?
  lastRunAt       DateTime? @map("last_run_at")
  lastSuccessAt   DateTime? @map("last_success_at")
  status          String    @default("IDLE")
  recordsUpserted Int       @default(0) @map("records_upserted")
  lastError       String?   @map("last_error")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("xero_sync_state")
}

enum TeamRole {
  LEAD
  MEMBER
}

/// Catalog of the ClickUp "Client" dropdown's options. Populated from ClickUp's
/// field definitions, not from tasks, so new clients appear before they have work.
model ClickupClientOption {
  optionId String   @id @map("option_id") // ClickUp option UUID
  fieldId  String   @map("field_id")
  name     String // current label; updated on rename
  archived Boolean  @default(false) // option removed in ClickUp
  syncedAt DateTime @default(now()) @updatedAt @map("synced_at")

  team TeamClient?

  @@index([fieldId])
  @@map("clickup_client_options")
}

model Team {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  org         Organization     @relation(fields: [orgId], references: [id])
  clients     TeamClient[]
  members     TeamMember[]
  invitations InvitationTeam[]
  employees   Employee[]

  @@unique([orgId, name])
  @@map("teams")
}

/// A client belongs to at most one team: `optionId` is the primary key.
model TeamClient {
  optionId  String   @id @map("option_id")
  teamId    String   @map("team_id")
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  team   Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  option ClickupClientOption @relation(fields: [optionId], references: [optionId])

  @@index([teamId])
  @@map("team_clients")
}

model TeamMember {
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER)
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Team assignments carried by a pending invitation, applied on accept.
model InvitationTeam {
  invitationId String   @map("invitation_id")
  teamId       String   @map("team_id")
  role         TeamRole @default(MEMBER)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([invitationId, teamId])
  @@map("invitation_teams")
}

// ── People: employee records, attendance and leave (slice 1) ───────────────
// Spec: docs/superpowers/specs/2026-10-07-people-attendance-design.md

enum EmployeeStatus {
  /// An intern (0034): before probation. Only the internship review applies.
  INTERN
  PROBATION
  ACTIVE
  NOTICE
  EXITED
}

enum EmploymentEventType {
  JOINED
  CONFIRMED
  PROMOTED
  DESIGNATION_CHANGED
  TRANSFERRED
  NOTICE_GIVEN
  EXITED
  NOTE
  /// Salary increment: from/to are the old/new gross salary (whole taka), notes the percent.
  INCREMENT
  /// An intern moved to probation (0034): effective date = the probation start; sets status
  /// PROBATION and `probation_start_date`.
  PROBATION_STARTED
  /// An internship extended (0034): from/to are the old/new internship end dates (YYYY-MM-DD).
  INTERNSHIP_EXTENDED
  /// Joined as an intern (0035, past records only): sets the join date and status INTERN.
  JOINED_AS_INTERN
}

/// Where an employment event came from (0035). APP: written by this system (every row before
/// 0035). PAST_RECORD: history before the system, entered by HR (import or "Add past record").
/// Since 0037 most APP events can be edited too (see `eventLock`); either way the employee is
/// re-derived by folding every event.
enum EventSource {
  APP
  PAST_RECORD
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// An employee is NOT a user: `userId` / `clickupUserId` are nullable links, made by email.
/// Work identity plus the appraisal form's header fields (0031). The salary columns are
/// sensitive: Owner/Admin only (every /people route) and never logged.
model Employee {
  id                            String         @id @default(cuid())
  orgId                         String         @map("org_id")
  fullName                      String         @map("full_name")
  /// Stored lower-cased; attendance providers key their rows on it.
  email                         String         @unique
  employeeCode                  String?        @unique @map("employee_code")
  userId                        String?        @unique @map("user_id")
  clickupUserId                 String?        @unique @map("clickup_user_id")
  designation                   String
  grade                         String?
  department                    String?
  teamId                        String?        @map("team_id")
  managerId                     String?        @map("manager_id")
  joinDate                      DateTime       @map("join_date") @db.Date
  /// When probation started (0034): the anchor of the confirmation, yearly and half-yearly
  /// schedule. Null = the join date (rows before 0034 were backfilled to it); null for an intern
  /// who has not started probation yet.
  probationStartDate            DateTime?      @map("probation_start_date") @db.Date
  /// INTERN: the expected internship end, when the internship review falls due (0034).
  internshipEndDate             DateTime?      @map("internship_end_date") @db.Date
  confirmationDate              DateTime?      @map("confirmation_date") @db.Date
  exitDate                      DateTime?      @map("exit_date") @db.Date
  status                        EmployeeStatus @default(PROBATION)
  /// Company within the group the employee works for.
  concernName                   String?        @map("concern_name")
  academicQualification         String?        @map("academic_qualification")
  /// Months of experience before joining; total experience = this + tenure.
  experienceBeforeJoiningMonths Int?           @map("experience_before_joining_months")
  /// Whole taka (BDT).
  startingSalary                Int?           @map("starting_salary")
  /// Present gross salary, whole taka (BDT). An INCREMENT event moves it.
  grossSalary                   Int?           @map("gross_salary")
  /// Internal (0035), never in a view: per field group, the values this row had before the
  /// group's first past record, so deleting the last past record of a group restores them.
  /// Holds a salary: never logged.
  pastRecordsBaseline           Json?          @map("past_records_baseline")
  /// Stellar HRM (office door / attendance system) numeric User ID. Imports match on it only (0036).
  attendanceId                  String?        @unique @map("attendance_id")
  /// Working shift (0036): lateness and expected hours. Null = the 09:30 default.
  shiftId                       String?        @map("shift_id")
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @default(now()) @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id])
  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  team    Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  manager Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  shift   WorkShift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reports Employee[]   @relation("EmployeeManager")

  events         EmploymentEvent[]
  attendances    AttendanceDay[]
  leaves         LeaveRecord[]
  documents      EmployeeDocument[]
  appraisals     Appraisal[]        @relation("AppraisalEmployee")
  reviewing      Appraisal[]        @relation("AppraisalReviewer")
  exits          EmployeeExit[]
  onboarding     OnboardingItem[]
  pastAppraisals PastAppraisal[]

  @@index([orgId, status])
  @@index([teamId])
  @@index([managerId])
  @@index([shiftId])
  @@map("employees")
}

model EmploymentEvent {
  id            BigInt              @id @default(autoincrement())
  employeeId    String              @map("employee_id")
  type          EmploymentEventType
  effectiveDate DateTime            @map("effective_date") @db.Date
  fromValue     String?             @map("from_value")
  toValue       String?             @map("to_value")
  notes         String?
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  createdBy     String?             @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  source        EventSource         @default(APP)
  /// The approved appraisal whose outcome wrote this event (0037). Such events back a signed
  /// form, so they stay locked on the timeline. Deliberately no FK.
  appraisalId   String?             @map("appraisal_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveDate])
  @@map("employment_events")
}

/// One row per employee per Dhaka calendar date, written by the attendance provider sync.
/// Who wrote an attendance row. Real data (STELLAR_*) is never overwritten by the dummy sync (0036).
enum AttendanceSource {
  DUMMY
  STELLAR_CSV
  STELLAR_API
}

/// A working shift (0036). Minutes are after Dhaka midnight; end < start means it crosses midnight.
model WorkShift {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  name             String
  startMinutes     Int      @map("start_minutes")
  endMinutes       Int      @map("end_minutes")
  /// Late = first-in after start + grace.
  graceMinutes     Int      @default(15) @map("grace_minutes")
  /// False: the punctuality KPI and late badges do not apply (irregular hours).
  trackPunctuality Boolean  @default(true) @map("track_punctuality")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id])
  employees Employee[]

  @@unique([orgId, name])
  @@map("work_shifts")
}

/// Office holidays (0039): one row per date the office is closed. A holiday on a
/// Mon-Fri date is not a working day: nobody is absent or late, it is not an
/// available day for utilisation, and leave across it does not count it.
model Holiday {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  date      DateTime @db.Date
  name      String
  /// A projected date (moon-dependent, or before the official list is out) still to be confirmed.
  tentative Boolean  @default(false)
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, date])
  @@map("holidays")
}

model AttendanceDay {
  employeeId      String           @map("employee_id")
  date            DateTime         @db.Date
  firstIn         DateTime?        @map("first_in") @db.Timestamptz(6)
  lastOut         DateTime?        @map("last_out") @db.Timestamptz(6)
  /// lastOut - firstIn (the span), null when either is missing.
  minutesInOffice Int?             @map("minutes_in_office")
  /// In/out sessions that day (0036); null for providers that only report first/last.
  sessions        Int?
  /// Sum of the sessions' durations (0036); null when unknown.
  workedMinutes   Int?             @map("worked_minutes")
  /// The last session has no out punch (0036).
  missingOut      Boolean          @default(false) @map("missing_out")
  /// The attendance system's notes for the day, concatenated (0036).
  note            String?
  /// Provider that wrote the row ('DUMMY' rows can be purged with one DELETE).
  source          AttendanceSource
  syncedAt        DateTime         @default(now()) @updatedAt @map("synced_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, date])
  @@index([date])
  @@map("attendance_days")
}

model LeaveRecord {
  id         String      @id @default(cuid())
  employeeId String      @map("employee_id")
  type       LeaveType
  startDate  DateTime    @map("start_date") @db.Date
  /// Inclusive.
  endDate    DateTime    @map("end_date") @db.Date
  days       Decimal     @db.Decimal(5, 1)
  status     LeaveStatus @default(PENDING)
  reason     String?
  /// 'dummy' | 'manual' | 'stellar' (Stellar HRM leave import, 0036).
  source     String
  externalId String?     @map("external_id")
  /// A manual APPROVED/REJECTED decision. Set => a later provider sync must not touch the row.
  decidedBy  String?     @map("decided_by")
  decidedAt  DateTime?   @map("decided_at")
  syncedAt   DateTime    @default(now()) @updatedAt @map("synced_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([employeeId, startDate])
  @@map("leave_records")
}

enum DocumentCategory {
  IDENTITY
  EMPLOYMENT
  EDUCATION
  APPRAISAL
  EXIT
  PERSONAL
  /// The nominee's NID and photos, collected at joining.
  NOMINEE
  OTHER
}

/// Stored now, enforced when employee/lead access lands (people slice 6).
enum DocumentVisibility {
  HR_ONLY
  HR_AND_EMPLOYEE
  EVERYONE
}

/// An employee's file, stored in a private S3-compatible bucket (MinIO) and streamed through
/// the backend. A replace inserts a new row and points the OLD row's `replacedById` at it, so
/// the current version of a document is the row with `replacedById IS NULL AND deletedAt IS NULL`.
/// Delete is soft (the object stays in the bucket).
model EmployeeDocument {
  id           String             @id
  employeeId   String             @map("employee_id")
  category     DocumentCategory
  /// A key from the document-type vocabulary (e.g. NATIONAL_ID) so the required checklist can match it.
  docType      String             @map("doc_type")
  fileName     String             @map("file_name")
  /// Sniffed from the file's magic bytes, never the client's Content-Type.
  contentType  String             @map("content_type")
  sizeBytes    Int                @map("size_bytes")
  sha256       String
  /// `employees/<employeeId>/<documentId>`.
  storageKey   String             @unique @map("storage_key")
  version      Int                @default(1)
  /// The newer version that superseded this row; null on the current version.
  replacedById String?            @unique @map("replaced_by_id")
  expiresOn    DateTime?          @map("expires_on") @db.Date
  visibility   DocumentVisibility @default(HR_ONLY)
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  uploadedBy   String?            @map("uploaded_by")
  createdAt    DateTime           @default(now()) @map("created_at")
  deletedAt    DateTime?          @map("deleted_at")

  /// Restrict, not Cascade: deleting an employee row must not orphan objects in the bucket.
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  replacedBy      EmployeeDocument? @relation("DocumentVersions", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces        EmployeeDocument? @relation("DocumentVersions")
  onboardingItems OnboardingItem[]
  pastAppraisals  PastAppraisal[]

  @@index([employeeId, deletedAt])
  @@index([expiresOn])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// People slice 3: appraisals. Spec: docs/superpowers/specs/2026-10-07-people-attendance-design.md
// ---------------------------------------------------------------------------

enum AppraisalCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

/// KPI_BLEND cycles: SELF_REVIEW -> LEAD_REVIEW -> CALIBRATION -> SIGNED_OFF.
/// INTERNSHIP cycles: SELF_REVIEW -> LEAD_REVIEW (supervisor) -> HR_REVIEW (decision) -> SIGNED_OFF.
/// FORM_100 cycles: SELF_REVIEW -> LEAD_REVIEW (supervisor) -> DEPT_HEAD_REVIEW -> HR_REVIEW
/// -> FINAL_APPROVAL (CTO/COO) -> SIGNED_OFF.
enum AppraisalStatus {
  SELF_REVIEW
  LEAD_REVIEW
  CALIBRATION
  SIGNED_OFF
  DEPT_HEAD_REVIEW
  HR_REVIEW
  FINAL_APPROVAL
}

/// Legacy (KPI_BLEND) single recommendation.
enum AppraisalRecommendation {
  PROMOTE
  RAISE
  NO_CHANGE
  IMPROVEMENT_PLAN
}

/// Which paper form a cycle is.
enum AppraisalType {
  HALF_YEARLY
  CONFIRMATION
  YEARLY
  /// Internship review (0034): due at the internship end, interns only.
  INTERNSHIP
}

/// The supervisor's single recommendation on an internship review (0034).
enum InternshipOutcome {
  MOVE_TO_PROBATION
  EXTEND_INTERNSHIP
  END_INTERNSHIP
}

/// How a cycle's period is read. CALENDAR: the cycle's period is everyone's review period.
/// JOIN_DATE: appraisals are counted from each employee's join date; the cycle's period is the
/// window the due dates fall in, and each appraisal carries its own review period and due date.
enum AppraisalPeriodBasis {
  CALENDAR
  JOIN_DATE
}

/// FORM_100: the paper form's 100-mark total and A-F grade are the official result; the KPI
/// score is shown beside it as a reference. KPI_BLEND: the original 0-5 KPI/competency blend.
enum AppraisalScoringMode {
  KPI_BLEND
  FORM_100
}

/// FORM_100 "Recommendations by Supervisor / Department Head" (multi-select).
enum AppraisalAction {
  CONFIRM
  INCREMENT
  PROMOTION
  TERMINATION
  DISMISSAL
  TRAINING_TRANSFER
}

/// The CTO/COO's decision at final approval.
enum AppraisalDecision {
  APPROVED
  NOT_APPROVED
}

/// From when an approved FORM_100 outcome takes effect (0033). DUE_DATE backdates it to the
/// appraisal's due date; APPROVAL_DATE is the sign-off date; CUSTOM is `effective_date`.
enum AppraisalEffectiveDate {
  DUE_DATE
  APPROVAL_DATE
  CUSTOM
}

model AppraisalCycle {
  id           String               @id @default(cuid())
  orgId        String               @map("org_id")
  name         String
  periodStart  DateTime             @map("period_start") @db.Date
  periodEnd    DateTime             @map("period_end") @db.Date
  status       AppraisalCycleStatus @default(DRAFT)
  type         AppraisalType        @default(YEARLY)
  /// Cycles created before 0032 were backfilled CALENDAR; new cycles default to JOIN_DATE, where
  /// periodStart/periodEnd mean "due between".
  periodBasis  AppraisalPeriodBasis @default(JOIN_DATE) @map("period_basis")
  /// Cycles created before 0031 were backfilled KPI_BLEND; new cycles default to the form.
  scoringMode  AppraisalScoringMode @default(FORM_100) @map("scoring_mode")
  /// 0-100: share of the final score that comes from the KPIs; the rest is competencies. KPI_BLEND only.
  kpiWeight    Int                  @default(70) @map("kpi_weight")
  /// `[{ key, label, description? }]`. Ratings on an appraisal are keyed by `key`.
  competencies Json
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  createdBy    String?              @map("created_by")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at")

  org        Organization @relation(fields: [orgId], references: [id])
  appraisals Appraisal[]

  @@index([orgId, status])
  @@map("appraisal_cycles")
}

model Appraisal {
  id         String          @id @default(cuid())
  cycleId    String          @map("cycle_id")
  employeeId String          @map("employee_id")
  /// Another employee (defaults to the employee's manager at launch).
  reviewerId String?         @map("reviewer_id")
  status     AppraisalStatus @default(SELF_REVIEW)

  /// JOIN_DATE cycles: this employee's own review period and due date (from the join date).
  /// Null means the cycle's period applies (calendar cycles and appraisals created before 0032).
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date

  /// `{ [competencyKey]: rating }`: 1-5 (KPI_BLEND) or 2/4/6/8/10 (FORM_100). A missing key is unrated.
  selfRatings     Json                     @default("{}") @map("self_ratings")
  selfComment     String?                  @map("self_comment")
  leadRatings     Json                     @default("{}") @map("lead_ratings")
  leadComment     String?                  @map("lead_comment")
  strengths       String?
  improvements    String?
  goals           String?
  recommendation  AppraisalRecommendation?
  /// Required when `recommendation` is PROMOTE.
  newDesignation  String?                  @map("new_designation")
  calibrationNote String?                  @map("calibration_note")
  /// 0-5, 1 dp. When set it replaces the computed score.
  calibratedScore Float?                   @map("calibrated_score")

  // --- FORM_100 (the paper form) ---
  /// Supervisor / department head recommendations. Required: PROMOTION -> newDesignation,
  /// INCREMENT -> incrementPercent.
  actions           AppraisalAction[]       @default([])
  /// Prefilled in the UI from the grade's range; editable.
  incrementPercent  Float?                  @map("increment_percent")
  /// "Training need / development plan (if any)".
  trainingPlan      String?                 @map("training_plan")
  deptHeadComment   String?                 @map("dept_head_comment")
  hrComment         String?                 @map("hr_comment")
  approvalDecision  AppraisalDecision?      @map("approval_decision")
  approvalComment   String?                 @map("approval_comment")
  /// Chosen at final approval. Null = the default, resolved at sign-off: DUE_DATE when the
  /// appraisal is late, else APPROVAL_DATE. Rows before 0033 were backfilled APPROVAL_DATE.
  effectiveDateMode AppraisalEffectiveDate? @map("effective_date_mode")
  /// CUSTOM: the chosen date. From sign-off: the resolved date the outcome events use.
  effectiveDate     DateTime?               @map("effective_date") @db.Date
  /// The form's header block (employee, experience, salary); captured at launch, refreshed
  /// with the KPIs and on every step, frozen at sign-off.
  formHeader        Json?                   @map("form_header")
  /// The stored PDF of the signed-off form (employee_documents.id, no FK: documents are soft-deleted).
  formDocumentId    String?                 @map("form_document_id")

  // --- INTERNSHIP reviews (0034) ---
  /// Exactly one recommendation; internship reviews never use `actions`.
  internshipOutcome      InternshipOutcome? @map("internship_outcome")
  /// MOVE_TO_PROBATION: the chosen probation start date.
  proposedProbationStart DateTime?          @map("proposed_probation_start") @db.Date
  /// EXTEND_INTERNSHIP: the new internship end date.
  proposedInternshipEnd  DateTime?          @map("proposed_internship_end") @db.Date

  /// Who completed each step and when (user ids; null for a machine credential). Deliberately no FK.
  leadReviewBy String?   @map("lead_review_by")
  leadReviewAt DateTime? @map("lead_review_at")
  deptHeadBy   String?   @map("dept_head_by")
  deptHeadAt   DateTime? @map("dept_head_at")
  hrBy         String?   @map("hr_by")
  hrAt         DateTime? @map("hr_at")
  approvalBy   String?   @map("approval_by")
  approvalAt   DateTime? @map("approval_at")

  /// Computed KPIs for the cycle period (never typed); frozen at sign-off. FORM_100 shows it as a reference only.
  kpiSnapshot   Json?     @map("kpi_snapshot")
  kpiSnapshotAt DateTime? @map("kpi_snapshot_at")

  /// The score as it stood at sign-off, so history never moves if the maths is later tuned.
  /// KPI_BLEND: 0-5. FORM_100: the 100-mark total.
  finalScore   Float?   @map("final_score")
  finalPartial Boolean? @map("final_partial")
  /// FORM_100: the A-F grade at sign-off.
  finalGrade   String?  @map("final_grade")

  signedOffAt      DateTime? @map("signed_off_at")
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  signedOffBy      String?   @map("signed_off_by")
  /// Set once the recommendation's employment event has been written; makes sign-off idempotent.
  outcomeAppliedAt DateTime? @map("outcome_applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  cycle    AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee       @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee?      @relation("AppraisalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("appraisals")
}

// ---------------------------------------------------------------------------
// People slice 4: exit / offboarding (migration 0028_employee_exits)
// ---------------------------------------------------------------------------

enum ExitType {
  RESIGNATION
  TERMINATION
  CONTRACT_END
  OTHER
}

/// NOTICE -> INTERVIEW -> CLEARANCE -> COMPLETED, or CANCELLED from any of the first three.
enum ExitStatus {
  NOTICE
  INTERVIEW
  CLEARANCE
  COMPLETED
  CANCELLED
}

enum ExitInterviewReason {
  CAREER_GROWTH
  COMPENSATION
  MANAGEMENT
  WORK_LIFE_BALANCE
  RELOCATION
  STUDIES
  OTHER
}

enum ExitAnswer {
  YES
  MAYBE
  NO
}

/// One offboarding. At most ONE active (NOTICE/INTERVIEW/CLEARANCE) per employee: a partial unique
/// index in the migration enforces it (Prisma cannot express a partial index). The exit interview
/// lives on this row. Org scoping goes through the employee, as it does for documents.
model EmployeeExit {
  id                 String               @id @default(cuid())
  employeeId         String               @map("employee_id")
  type               ExitType
  status             ExitStatus           @default(NOTICE)
  noticeDate         DateTime             @map("notice_date") @db.Date
  lastWorkingDay     DateTime             @map("last_working_day") @db.Date
  reason             String?
  /// The employee's status before NOTICE_GIVEN, so a cancel can put it back.
  previousStatus     EmployeeStatus       @map("previous_status")
  interviewReason    ExitInterviewReason? @map("interview_reason")
  ratingRole         Int?                 @map("rating_role")
  ratingLead         Int?                 @map("rating_lead")
  ratingCompensation Int?                 @map("rating_compensation")
  ratingGrowth       Int?                 @map("rating_growth")
  ratingEnvironment  Int?                 @map("rating_environment")
  interviewFeedback  String?              @map("interview_feedback")
  wouldRecommend     ExitAnswer?          @map("would_recommend")
  wouldRejoin        ExitAnswer?          @map("would_rejoin")
  /// HR only.
  interviewNotes     String?              @map("interview_notes")
  /// User ids of actors; null for a machine credential. Deliberately no FK.
  interviewBy        String?              @map("interview_by")
  interviewAt        DateTime?            @map("interview_at")
  /// Why the exit was completed with clearance items still open (neither done nor N/A).
  overrideNote       String?              @map("override_note")
  loginDisabled      Boolean              @default(false) @map("login_disabled")
  completedAt        DateTime?            @map("completed_at")
  completedBy        String?              @map("completed_by")
  cancelledAt        DateTime?            @map("cancelled_at")
  cancelledBy        String?              @map("cancelled_by")
  cancelNote         String?              @map("cancel_note")
  createdBy          String?              @map("created_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    ExitClearanceItem[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@map("employee_exits")
}

/// The two sections of the company's exit checklist: process tasks, and company assets to collect.
enum ExitChecklistGroup {
  PROCESS
  ASSETS
}

/// One line of an exit's checklist. It is resolved when done OR not applicable; the two are
/// mutually exclusive (the service clears one when it sets the other).
model ExitClearanceItem {
  id              String             @id @default(cuid())
  exitId          String             @map("exit_id")
  group           ExitChecklistGroup @default(PROCESS) @map("group_kind")
  /// Stable id of a seeded item (e.g. `exit_interview`), so code can find it whatever its label
  /// says. Null for custom items.
  key             String?
  label           String
  position        Int
  done            Boolean            @default(false)
  doneBy          String?            @map("done_by")
  doneAt          DateTime?          @map("done_at")
  notApplicable   Boolean            @default(false) @map("not_applicable")
  notApplicableBy String?            @map("not_applicable_by")
  notApplicableAt DateTime?          @map("not_applicable_at")
  note            String?

  exit EmployeeExit @relation(fields: [exitId], references: [id], onDelete: Cascade)

  @@unique([exitId, key])
  @@index([exitId, position])
  @@map("exit_clearance_items")
}

// ---------------------------------------------------------------------------
// People: joining (onboarding) checklist, after the company's "Check List of Joining" form.
// Spec: docs/superpowers/specs/2026-10-07-people-attendance-design.md ("Onboarding checklist")
// ---------------------------------------------------------------------------

enum OnboardingGroup {
  DOCUMENTS
  EQUIPMENT
  ACCOUNTS
  WELCOME
}

/// One line of an employee's joining checklist. Seeded items carry a stable `key` (e.g.
/// `doc_resume`, `eq_laptop`); custom items have none. Resolved = `done` OR `notApplicable`
/// (never both — the service keeps them mutually exclusive).
model OnboardingItem {
  id              String          @id @default(cuid())
  employeeId      String          @map("employee_id")
  group           OnboardingGroup
  /// Stable key for a seeded item; null for a custom one. Unique per employee (NULLs are distinct).
  key             String?
  label           String
  position        Int
  done            Boolean         @default(false)
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  doneBy          String?         @map("done_by")
  doneAt          DateTime?       @map("done_at")
  notApplicable   Boolean         @default(false) @map("not_applicable")
  notApplicableBy String?         @map("not_applicable_by")
  notApplicableAt DateTime?       @map("not_applicable_at")
  note            String?
  /// Free text: laptop serial, SIM number, email address...
  detail          String?
  /// The uploaded document that satisfies this item. A soft-deleted or replaced document is
  /// resolved on read (soft delete does not fire SetNull).
  documentId      String?         @map("document_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([employeeId, key])
  @@index([employeeId, position])
  @@index([documentId])
  @@map("onboarding_items")
}

/// An appraisal done outside the system (on paper, before it), entered as a past record (0035).
/// Counts as "already appraised" in the schedule exactly like a real appraisal, at its due date
/// (else the date it was conducted). Informational: nothing here runs an outcome.
model PastAppraisal {
  id          String            @id @default(cuid())
  employeeId  String            @map("employee_id")
  type        AppraisalType
  /// The milestone it was for, when known; else `conductedOn` stands in for it.
  dueDate     DateTime?         @map("due_date") @db.Date
  conductedOn DateTime          @map("conducted_on") @db.Date
  /// 0-100.
  marks       Float?
  /// A-F.
  grade       String?
  outcome     String?
  /// What was recommended, for the record only.
  actions     AppraisalAction[] @default([])
  /// The scanned form (an employee document); cleared if that row is ever removed.
  documentId  String?           @map("document_id")
  notes       String?
  /// User id of the actor; null for a machine credential. Deliberately no FK.
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  document EmployeeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([employeeId, type, conductedOn])
  @@index([employeeId, type])
  @@map("past_appraisals")
}

    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst normalized = [];\n\nitems.forEach(({ json }) => {\n  // Skip header row or empty rows\n  if (!json.assignee_id || json.assignee_id === 'assignee_id') {\n    return;\n  }\n  \n  // Validate required fields\n  if (!json.valid_from) {\n    console.error(`Missing valid_from for ${json.assignee_name}`);\n    return;\n  }\n  \n  // Convert rate to integer\n  const hourlyRateCents = parseInt(json.hourly_rate_cents, 10);\n  if (isNaN(hourlyRateCents)) {\n    console.error(`Invalid rate for ${json.assignee_name}: ${json.hourly_rate_cents}`);\n    return;\n  }\n  \n  // Parse valid_to - convert empty/null to null, otherwise validate date\n  let validTo = null;\n  if (json.valid_to && String(json.valid_to).trim() !== '') {\n    validTo = String(json.valid_to).slice(0, 10).trim();\n    // Validate date format\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(validTo)) {\n      console.error(`Invalid valid_to date for ${json.assignee_name}: ${validTo}`);\n      return;\n    }\n  }\n  \n  normalized.push({\n    json: {\n      assignee_id: String(json.assignee_id).trim(),\n      assignee_name: String(json.assignee_name || '').trim(),\n      assignee_email: String(json.assignee_email || '').trim(),\n      currency: String(json.currency || 'AUD').trim(),\n      hourly_rate_cents: hourlyRateCents,\n      valid_from: String(json.valid_from).slice(0, 10).trim(),\n      valid_to: validTo  // Will be null if empty/invalid\n    }\n  });\n});\n\nreturn normalized;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        112
      ],
      "id": "d9fda8a4-7783-4945-9f08-de2ed9ef7e33",
      "name": "Code"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upsert AS (\n    UPDATE assignee_rates\n    SET\n        assignee_name = $2,\n        assignee_email = $3,\n        currency = $4,\n        hourly_rate_cents = $5,\n        valid_to = $7,\n        updated_at = NOW()\n    WHERE assignee_id = $1\n      AND valid_from = $6\n    RETURNING rate_id, assignee_id, valid_from, hourly_rate_cents\n)\nINSERT INTO assignee_rates (\n    assignee_id,\n    assignee_name,\n    assignee_email,\n    currency,\n    hourly_rate_cents,\n    valid_from,\n    valid_to,\n    updated_at\n)\nSELECT $1, $2, $3, $4, $5, $6, $7, NOW()\nWHERE NOT EXISTS (SELECT 1 FROM upsert)\nRETURNING rate_id, assignee_id, valid_from, hourly_rate_cents;",
        "options": {
          "queryReplacement": "={{ $json.assignee_id }},{{ $json.assignee_name }},{{ $json.assignee_email }},{{ $json.currency }},{{ $json.hourly_rate_cents }},{{ $json.valid_from }},{{ $json.valid_to ? $json.valid_to : null }}"
        }
